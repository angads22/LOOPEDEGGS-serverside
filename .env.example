# LifeLoop Hub — copy to .env and adjust as needed.
# Compose reads this file automatically (see docker-compose.yml).

# --- App ---------------------------------------------------------------------
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://loopedeggs.ca,https://www.loopedeggs.ca

# --- Container deployment ----------------------------------------------------
# Image to run. Pin a specific tag in production, e.g.:
#   ghcr.io/angads22/loopedeggs-serverside:v1.0.0
LIFELOOP_IMAGE=ghcr.io/angads22/loopedeggs-serverside:latest

# Host port to publish (container always listens on 3000).
LIFELOOP_PORT=3000

# Where Watchtower can find Docker credentials for private images.
# Defaults to ~/.docker on the host.
# DOCKER_CONFIG_DIR=/root/.docker
